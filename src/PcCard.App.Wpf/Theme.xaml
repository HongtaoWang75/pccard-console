<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- PcCard 设计令牌（与 Kimi 规范 v1.0 完全一致的色值） -->
    <SolidColorBrush x:Key="PcPageBackground" Color="#FF202020" />
    <SolidColorBrush x:Key="PcSurface"        Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="PcSurface2"       Color="#FF323232" />
    <SolidColorBrush x:Key="PcBorder"         Color="#FF3D3D3D" />
    <SolidColorBrush x:Key="PcRowSeparator"   Color="#FF2F2F2F" />

    <SolidColorBrush x:Key="PcTextPrimary"   Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PcTextSecondary" Color="#FFC5C5C5" />
    <SolidColorBrush x:Key="PcTextTertiary"  Color="#FF8B8B8B" />

    <SolidColorBrush x:Key="PcAccent"        Color="#FF017D7B" />
    <SolidColorBrush x:Key="PcAccentHover"   Color="#FF0E958F" />
    <SolidColorBrush x:Key="PcAccentPressed" Color="#FF016B69" />
    <SolidColorBrush x:Key="PcAccentText"    Color="#FF2BB5AD" />
    <SolidColorBrush x:Key="PcOn"            Color="#FF2BB5AD" />
    <SolidColorBrush x:Key="PcOff"           Color="#FF8494A0" />
    <SolidColorBrush x:Key="PcOffStripe"     Color="#FF5A6670" />
    <SolidColorBrush x:Key="PcUnknown"       Color="#FF8B8B8B" />
    <SolidColorBrush x:Key="PcDanger"        Color="#FFF47067" />
    <SolidColorBrush x:Key="PcDangerSoft"    Color="#1AF47067" />
    <SolidColorBrush x:Key="PcWarn"          Color="#FFFFB84D" />
    <SolidColorBrush x:Key="PcSuccess"       Color="#FF4CCB5F" />
    <SolidColorBrush x:Key="PcSuccessSoft"   Color="#1A4CCB5F" />
    <SolidColorBrush x:Key="PcNeutralSoft"   Color="#1AFFFFFF" />

    <FontFamily x:Key="PcMonoFont">Consolas</FontFamily>
    <FontFamily x:Key="PcIconFont">Segoe MDL2 Assets</FontFamily>

    <!-- ═══ 主操作键（品牌主色 #017D7B）═══ -->
    <Style x:Key="PcPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PcAccent}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource PcAccentHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource PcAccentPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource PcSurface2}" />
                            <Setter Property="Foreground" Value="{StaticResource PcTextTertiary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ 次级/图标按钮 ═══ -->
    <Style x:Key="PcSecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PcSurface2}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource PcBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#FF3A3A3A" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#FF2F2F2F" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource PcTextTertiary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PcIconButton" TargetType="Button" BasedOn="{StaticResource PcSecondaryButton}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource PcIconFont}" />
        <Setter Property="FontSize" Value="14" />
    </Style>
</ResourceDictionary>
