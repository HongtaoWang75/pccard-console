<Window x:Class="PcCard.AppWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="开机卡控制台"
        Width="980" Height="700"
        MinWidth="860" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PcPageBackground}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Grid x:Name="RootGrid" Background="{StaticResource PcPageBackground}" Margin="20,16,20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ ① 状态卡 ═══ -->
        <Border Grid.Row="0" Background="{StaticResource PcSurface}"
                BorderBrush="{StaticResource PcBorder}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Rectangle x:Name="StatusStripe" Fill="{StaticResource PcUnknown}" RadiusX="1.5" RadiusY="1.5" />

                <Grid Grid.Column="1" Margin="18,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="DeviceNameText" Text="（未选择设备）"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource PcTextPrimary}" VerticalAlignment="Center" />
                            <Ellipse x:Name="OnlineDot" Width="8" Height="8" Margin="8,0,0,0"
                                     Fill="{StaticResource PcUnknown}" VerticalAlignment="Center" />
                            <TextBlock x:Name="OnlineText" Text="状态未知" FontSize="12" Margin="8,0,0,0"
                                       Foreground="{StaticResource PcTextSecondary}" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock x:Name="BigStateText" Text="状态未知"
                                   FontSize="34" FontWeight="Bold" Margin="0,4,0,0"
                                   Foreground="{StaticResource PcTextTertiary}" />

                        <TextBlock x:Name="MetaText" Text="设备类型 — · 旁路 — · 上次操作 —"
                                   FontSize="12" Margin="0,4,0,0"
                                   Foreground="{StaticResource PcTextTertiary}" />

                        <TextBlock x:Name="OfflineWarnText" Visibility="Collapsed"
                                   FontSize="12" Margin="0,4,0,0" Foreground="{StaticResource PcWarn}"
                                   Text="⚠ 开机卡离线，请检查网络后刷新" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox x:Name="DeviceCombo" Width="224" Height="32" FontSize="13"
                                  VerticalContentAlignment="Center"
                                  Background="{StaticResource PcSurface2}"
                                  Foreground="White" BorderBrush="{StaticResource PcBorder}"
                                  SelectionChanged="OnDeviceChanged" />
                        <Button x:Name="RefreshBtn" Style="{StaticResource PcIconButton}" Margin="8,0,0,0"
                                Click="OnRefreshClick" ToolTip="刷新状态" Content="&#xE72C;" />
                        <Button x:Name="SettingsBtn" Style="{StaticResource PcIconButton}" Margin="8,0,0,0"
                                Click="OnSettingsClick" ToolTip="设备设置（童锁 / 指示灯 / 通电自动开机）" Content="&#xE713;" />
                        <ProgressBar x:Name="BusyRing" Width="60" Height="3" Margin="8,0,0,0"
                                     VerticalAlignment="Center" Visibility="Hidden"
                                     IsIndeterminate="True" Background="Transparent"
                                     Foreground="{StaticResource PcAccentText}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══ ② 操作区 ═══ -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="PowerOnBtn" Grid.Column="0" Style="{StaticResource PcPrimaryButton}" Height="56" Margin="0,0,6,0" Click="OnPowerOnClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource PcIconFont}" FontSize="15" Text="&#xE7E8;" VerticalAlignment="Center" />
                    <TextBlock Text="开机" FontSize="15" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button x:Name="PowerOffBtn" Grid.Column="1" Style="{StaticResource PcPrimaryButton}" Height="56" Margin="6,0,6,0" Click="OnPowerOffClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource PcIconFont}" FontSize="15" Text="&#xE7E8;" VerticalAlignment="Center" />
                    <TextBlock x:Name="PowerOffLabel" Text="关机" FontSize="15" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button x:Name="RebootBtn" Grid.Column="2" Style="{StaticResource PcPrimaryButton}" Height="56" Margin="6,0,6,0" Click="OnRebootClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource PcIconFont}" FontSize="15" Text="&#xE72C;" VerticalAlignment="Center" />
                    <TextBlock x:Name="RebootLabel" Text="重启" FontSize="15" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <CheckBox x:Name="ForceCheck" Grid.Column="3" Content="强制" FontSize="13" Foreground="White"
                      VerticalAlignment="Center" Margin="6,0,0,0"
                      Checked="OnForceChanged" Unchecked="OnForceChanged"
                      ToolTip="勾选后：关机=强制关机、重启=强制重启（模拟长按电源键）。本卡为 Basic 档，官方 App 隐藏此功能，属实验性；云端不支持时会明确报错。" />
        </Grid>

        <!-- ═══ ③ 定时任务 ═══ -->
        <Border Grid.Row="2" Margin="0,12,0,0" Background="{StaticResource PcSurface}"
                BorderBrush="{StaticResource PcBorder}" BorderThickness="1" CornerRadius="8" Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <TextBlock Text="定时任务" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource PcTextPrimary}" VerticalAlignment="Center" />
                    <Button x:Name="AddTaskBtn" Content="+ 新增" FontSize="13" HorizontalAlignment="Right"
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource PcAccentText}"
                            Padding="6,2" Cursor="Hand" Click="OnAddTaskClick" />
                </Grid>

                <TextBlock x:Name="TasksWarnText" Grid.Row="1" Visibility="Collapsed" Margin="0,2,0,0"
                           FontSize="12" Foreground="{StaticResource PcWarn}"
                           Text="⚠ 需要管理员权限才能创建/修改系统计划任务" />

                <Grid Grid.Row="2">
                    <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="TasksList" Margin="0,2,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                  VerticalAlignment="Center" Foreground="White" />

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Title}" FontSize="14"
                                                       Foreground="{StaticResource PcTextPrimary}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding RuleAndAction}" FontSize="12" Margin="12,0,0,0"
                                                       Foreground="{StaticResource PcTextSecondary}" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <Border Grid.Column="2" CornerRadius="999" Background="{Binding ResultPillBrush}"
                                                Padding="8,3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ResultPillText}" FontSize="12"
                                                       Foreground="{Binding ResultPillTextBrush}" />
                                        </Border>

                                        <Button Grid.Column="3" Tag="{Binding Id}" Click="OnTaskDelete"
                                                Style="{StaticResource PcIconButton}" Width="26" Height="26"
                                                Margin="8,0,0,0" Background="Transparent" BorderThickness="0"
                                                ToolTip="删除" Content="&#xE711;" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="TasksEmptyText" Text="暂无定时任务" FontSize="13"
                               Foreground="{StaticResource PcTextTertiary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="0,16,0,16" Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Border>

        <!-- ═══ ④ 操作日志 ═══ -->
        <Border Grid.Row="3" Margin="0,12,0,0" Background="{StaticResource PcSurface}"
                BorderBrush="{StaticResource PcBorder}" BorderThickness="1" CornerRadius="8" Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="操作日志" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource PcTextPrimary}" />

                <Grid Grid.Row="1" Margin="0,4,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="LogsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TimeFull}" FontSize="12"
                                                   FontFamily="{StaticResource PcMonoFont}"
                                                   Foreground="{StaticResource PcTextTertiary}" />
                                        <TextBlock Grid.Column="1" Text="{Binding SourceLabel}" FontSize="12"
                                                   Foreground="{StaticResource PcTextSecondary}" />
                                        <TextBlock Grid.Column="2" Text="{Binding ActionText}" FontSize="13"
                                                   Foreground="{StaticResource PcTextPrimary}" />
                                        <TextBlock Grid.Column="3" Text="{Binding ResultText}" FontSize="13"
                                                   Foreground="{Binding ResultBrush}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="LogsEmptyText" Text="暂无日志" FontSize="13"
                               Foreground="{StaticResource PcTextTertiary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Border>

        <!-- ═══ ⑤ 底部 ═══ -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="FooterDot" Width="8" Height="8" Fill="{StaticResource PcSuccess}" VerticalAlignment="Center" />
                <TextBlock x:Name="FooterText" Text="就绪" FontSize="12" Margin="8,0,0,0"
                           Foreground="{StaticResource PcTextTertiary}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="VersionText" FontSize="12" HorizontalAlignment="Right"
                       Foreground="{StaticResource PcTextTertiary}" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
