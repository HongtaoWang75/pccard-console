<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="PcCard.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- 品牌设计令牌（Kimi 视觉规范 v1.0 的落地处） -->
                <ResourceDictionary Source="ms-appx:///Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ═══ 控件主题覆盖 ═══
                 放在 Application 的主题字典里才能可靠压过 XamlControlsResources
                 自带的同名键（普通合并字典里的键未必优先于框架主题字典）。 -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <!-- 系统主色 → 品牌青绿（按钮/开关/焦点环等自动跟随） -->
                    <Color x:Key="SystemAccentColor">#FF017D7B</Color>
                    <Color x:Key="SystemAccentColorLight1">#FF0E958F</Color>
                    <Color x:Key="SystemAccentColorLight2">#FF2BB5AD</Color>
                    <Color x:Key="SystemAccentColorLight3">#FF5FCBC4</Color>
                    <Color x:Key="SystemAccentColorDark1">#FF016B69</Color>
                    <Color x:Key="SystemAccentColorDark2">#FF005654</Color>
                    <Color x:Key="SystemAccentColorDark3">#FF00403F</Color>

                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF017D7B" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF0E958F" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF016B69" />
                    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#FF3D3D3D" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E6FFFFFF" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#FF8B8B8B" />

                    <!-- 常规按钮：surface-2 底 + 1px 描边（规范 §3） -->
                    <SolidColorBrush x:Key="ButtonBackground" Color="#FF323232" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF3A3A3A" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FF2F2F2F" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#FF323232" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFC5C5C5" />
                    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#FF8B8B8B" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FF3D3D3D" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#FF3D3D3D" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#FF3D3D3D" />
                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#FF323232" />

                    <!-- 开关：开启=青绿轨白钮；关闭=透明轨 + 灰描边（规范 §3） -->
                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FF017D7B" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FF0E958F" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FF016B69" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#FF8B8B8B" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#FF017D7B" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FF8B8B8B" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <!-- 与 Default 完全一致（应用锁定深色，两条路都备上防意外） -->
                    <Color x:Key="SystemAccentColor">#FF017D7B</Color>
                    <Color x:Key="SystemAccentColorLight1">#FF0E958F</Color>
                    <Color x:Key="SystemAccentColorLight2">#FF2BB5AD</Color>
                    <Color x:Key="SystemAccentColorLight3">#FF5FCBC4</Color>
                    <Color x:Key="SystemAccentColorDark1">#FF016B69</Color>
                    <Color x:Key="SystemAccentColorDark2">#FF005654</Color>
                    <Color x:Key="SystemAccentColorDark3">#FF00403F</Color>

                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF017D7B" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF0E958F" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF016B69" />
                    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#FF3D3D3D" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E6FFFFFF" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#FF8B8B8B" />

                    <SolidColorBrush x:Key="ButtonBackground" Color="#FF323232" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF3A3A3A" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FF2F2F2F" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#FF323232" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFC5C5C5" />
                    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#FF8B8B8B" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FF3D3D3D" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#FF3D3D3D" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#FF3D3D3D" />
                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#FF323232" />

                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FF017D7B" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FF0E958F" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FF016B69" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#FF8B8B8B" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#FF017D7B" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FF8B8B8B" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
