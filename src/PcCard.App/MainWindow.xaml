<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PcCard.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Background="{StaticResource PcPageBackground}" Padding="20,16,20,12">
        <!-- ═══ 控件配色（页面作用域，压过框架默认）═══
             ★ App 级主题字典里的同名键实测压不住框架（只有 SystemAccentColor 生效），
               页面级 + 实例级才是可靠落点（像素采样验证过）。 -->
        <Grid.Resources>
            <SolidColorBrush x:Key="ButtonBackground" Color="#FF323232" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF3A3A3A" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FF2F2F2F" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#FF323232" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFC5C5C5" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#FF8B8B8B" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FF3D3D3D" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#FF3D3D3D" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#FF3D3D3D" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#FF3D3D3D" />

            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FF017D7B" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FF0E958F" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FF016B69" />
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#FF8B8B8B" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#FF017D7B" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FF8B8B8B" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ ① 状态卡（左缘 3px 状态竖条 + 左信息右操作）═══ -->
        <Border Grid.Row="0"
                Background="{StaticResource PcSurface}"
                BorderBrush="{StaticResource PcBorder}"
                BorderThickness="1"
                CornerRadius="{StaticResource PcCardRadius}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Rectangle x:Name="StatusStripe" Fill="{StaticResource PcUnknown}" RadiusX="1.5" RadiusY="1.5" />

                <Grid Grid.Column="1" Padding="18,14" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="DeviceNameText" Text="（未选择设备）"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource PcTextPrimary}" VerticalAlignment="Center" />
                            <Ellipse x:Name="OnlineDot" Width="8" Height="8"
                                     Fill="{StaticResource PcUnknown}" VerticalAlignment="Center" />
                            <TextBlock x:Name="OnlineText" Text="状态未知" FontSize="12"
                                       Foreground="{StaticResource PcTextSecondary}" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock x:Name="BigStateText" Text="状态未知"
                                   FontSize="34" FontWeight="Bold" Margin="0,2,0,0"
                                   Foreground="{StaticResource PcTextTertiary}" />

                        <TextBlock x:Name="MetaText" Text="设备类型 — · 旁路 — · 最后刷新 —"
                                   FontSize="12" Foreground="{StaticResource PcTextTertiary}" />

                        <TextBlock x:Name="OfflineWarnText" Visibility="Collapsed"
                                   FontSize="12" Foreground="{StaticResource PcWarn}"
                                   Text="⚠ 开机卡离线，请检查网络后刷新" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ComboBox x:Name="DeviceCombo" Width="224" Height="32" FontSize="13"
                                  VerticalContentAlignment="Center"
                                  PlaceholderText="选择设备" SelectionChanged="OnDeviceChanged" />
                        <Button x:Name="RefreshBtn" Width="32" Height="32" Padding="0"
                                Click="OnRefreshClick" ToolTipService.ToolTip="刷新状态">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                        <Button x:Name="SettingsBtn" Width="32" Height="32" Padding="0"
                                Click="OnSettingsClick" ToolTipService.ToolTip="设备设置（童锁 / 指示灯 / 通电自动开机）">
                            <FontIcon Glyph="&#xE713;" FontSize="14" />
                        </Button>
                        <ProgressRing x:Name="BusyRing" Width="18" Height="18"
                                      IsActive="False" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══ ② 操作区（开机/关机/重启 + 强制勾选；当前可执行的那个独占主色，规范 §4）═══ -->
        <Grid Grid.Row="1" Margin="0,12,0,0" ColumnSpacing="12">
            <!-- 主色覆盖放本行作用域（一份顶三份）：规范色 #017D7B。
                 ★ 不依赖 AccentButtonStyle —— 它的静止色会解析成系统 Accent 的
                   Light2 变体（实测偏亮的 #2BB5AD），与规范 token 不符。 -->
            <Grid.Resources>
                <SolidColorBrush x:Key="ButtonBackground" Color="#FF017D7B" />
                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF0E958F" />
                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FF016B69" />
                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#FF323232" />
                <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFFFF" />
                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFFFF" />
                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFE6FFFFFF" />
                <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#FF8B8B8B" />
                <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#FF3D3D3D" />
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="PowerOnBtn" Grid.Column="0" Height="56" HorizontalAlignment="Stretch"
                    CornerRadius="{StaticResource PcButtonRadius}" Click="OnPowerOnClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7E8;" FontSize="15" />
                    <TextBlock Text="开机" FontSize="15" FontWeight="SemiBold" />
                </StackPanel>
            </Button>

            <Button x:Name="PowerOffBtn" Grid.Column="1" Height="56" HorizontalAlignment="Stretch"
                    CornerRadius="{StaticResource PcButtonRadius}" Click="OnPowerOffClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7E8;" FontSize="15" />
                    <TextBlock x:Name="PowerOffLabel" Text="关机" FontSize="15" FontWeight="SemiBold" />
                </StackPanel>
            </Button>

            <Button x:Name="RebootBtn" Grid.Column="2" Height="56" HorizontalAlignment="Stretch"
                    CornerRadius="{StaticResource PcButtonRadius}" Click="OnRebootClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="15" />
                    <TextBlock x:Name="RebootLabel" Text="重启" FontSize="15" FontWeight="SemiBold" />
                </StackPanel>
            </Button>

            <!-- 强制勾选：勾上后 关机→强制关机、重启→强制重启（写 piid5 的 3/2 档）。
                 本卡为 Basic 型号，官方 App 隐藏此功能 —— 属实验性，云端不支持会明确报错。 -->
            <CheckBox x:Name="ForceCheck" Grid.Column="3" Content="强制" FontSize="13"
                      VerticalAlignment="Center" Margin="4,0,0,0"
                      Checked="OnForceChanged" Unchecked="OnForceChanged"
                      ToolTipService.ToolTip="勾选后：关机=强制关机、重启=强制重启（模拟长按电源键）。本卡为 Basic 档，官方 App 隐藏此功能，属实验性；云端不支持时会明确报错。" />
        </Grid>

        <!-- ═══ ③ 定时任务 ═══ -->
        <Border Grid.Row="2" Margin="0,12,0,0"
                Background="{StaticResource PcSurface}"
                BorderBrush="{StaticResource PcBorder}" BorderThickness="1"
                CornerRadius="{StaticResource PcCardRadius}" Padding="16,12">
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <TextBlock Text="定时任务" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource PcTextPrimary}" VerticalAlignment="Center" />
                    <HyperlinkButton x:Name="AddTaskBtn" Content="+ 新增" FontSize="13"
                                     Foreground="{StaticResource PcAccentText}"
                                     HorizontalAlignment="Right" Click="OnAddTaskClick" />
                </Grid>

                <TextBlock x:Name="TasksWarnText" Grid.Row="1" Visibility="Collapsed"
                           FontSize="12" Foreground="{StaticResource PcWarn}"
                           Text="⚠ 需要管理员权限才能创建/修改系统计划任务" />

                <Grid Grid.Row="2">
                    <ListView x:Name="TasksList" SelectionMode="None" MaxHeight="150"
                              Background="Transparent" Padding="0,2,0,0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="44" />
                                <Setter Property="Padding" Value="0,0,8,0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 只有 TwoWay 绑定一条通路：变更经 VM 的 Enabled setter 触发回调 -->
                                    <ToggleSwitch Grid.Column="0" IsOn="{Binding Enabled, Mode=TwoWay}"
                                                  OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="14"
                                                   Foreground="{StaticResource PcTextPrimary}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding RuleAndAction}" FontSize="12"
                                                   Foreground="{StaticResource PcTextSecondary}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Border Grid.Column="2" CornerRadius="{StaticResource PcPillRadius}"
                                            Background="{Binding ResultPillBrush}" Padding="8,3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ResultPillText}" FontSize="12"
                                                   Foreground="{Binding ResultPillTextBrush}" />
                                    </Border>

                                    <Button Grid.Column="3" Tag="{Binding Id}" Click="OnTaskDelete"
                                            Width="28" Height="28" Padding="0" Background="Transparent"
                                            BorderThickness="0" VerticalAlignment="Center"
                                            ToolTipService.ToolTip="删除">
                                        <FontIcon Glyph="&#xE711;" FontSize="12"
                                                  Foreground="{StaticResource PcTextTertiary}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock x:Name="TasksEmptyText" Text="暂无定时任务" FontSize="13"
                               Foreground="{StaticResource PcTextTertiary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="0,18,0,18" Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Border>

        <!-- ═══ ④ 操作日志 ═══ -->
        <Border Grid.Row="3" Margin="0,12,0,0"
                Background="{StaticResource PcSurface}"
                BorderBrush="{StaticResource PcBorder}" BorderThickness="1"
                CornerRadius="{StaticResource PcCardRadius}" Padding="16,12">
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="操作日志" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource PcTextPrimary}" />

                <Grid Grid.Row="1">
                    <ListView x:Name="LogsList" SelectionMode="None"
                              Background="Transparent" Padding="0,2,0,0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="28" />
                                <Setter Property="Padding" Value="0,0,8,0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TimeFull}" FontSize="12"
                                               FontFamily="{StaticResource PcMonoFont}"
                                               Foreground="{StaticResource PcTextTertiary}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SourceLabel}" FontSize="12"
                                               Foreground="{StaticResource PcTextSecondary}" />
                                    <TextBlock Grid.Column="2" Text="{Binding ActionText}" FontSize="13"
                                               Foreground="{StaticResource PcTextPrimary}" />
                                    <TextBlock Grid.Column="3" Text="{Binding ResultText}" FontSize="13"
                                               Foreground="{Binding ResultBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock x:Name="LogsEmptyText" Text="暂无日志" FontSize="13"
                               Foreground="{StaticResource PcTextTertiary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Border>

        <!-- ═══ ⑤ 底部 ═══ -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse x:Name="FooterDot" Width="8" Height="8" Fill="{StaticResource PcSuccess}"
                         VerticalAlignment="Center" />
                <TextBlock x:Name="FooterText" Text="就绪" FontSize="12"
                           Foreground="{StaticResource PcTextTertiary}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="VersionText" FontSize="12" HorizontalAlignment="Right"
                       Foreground="{StaticResource PcTextTertiary}" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
